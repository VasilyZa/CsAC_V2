CSAC_BIND_IP=127.0.0.1
CSAC_PORT=8443
CSAC_CERT_DIR=./certs

# Generate with openssl rand -hex 32
CSAC_POSTGRES_PASSWORD=
# Generate separate values with openssl rand -base64 32
CSAC_PASSWORD_PEPPER=
CSAC_ACCOUNT_KEY=

CSAC_REQUIRE_REGISTRATION_EMAIL=true
CSAC_REQUIRE_MEMBER_EMAIL=true
# CSAC_ADMIN_UIDS=42,57
# CSAC_ALLOWED_ORIGINS=https://client.example.com
# Optional TLS reverse proxy. Generate a separate key with openssl rand -base64 32.
# Overwrite X-Csac-Proxy-Token and X-Real-IP at the proxy.
# CSAC_TRUSTED_PROXY_TOKEN=
# CSAC_FILE_RETENTION_DAYS=3
# CSAC_FILE_ALLOWED_TYPES=txt,pdf,png,zip
# CSAC_RELEASE_GITHUB_REPO=OWNER/REPO
# CSAC_RELEASE_POLL_MINUTES=360
# CSAC_RELEASE_DEPLOY_WEB=false
# CSAC_SMTP_HOST=smtp.example.com
# CSAC_SMTP_PORT=465
# CSAC_SMTP_USERNAME=
# CSAC_SMTP_PASSWORD=
# CSAC_SMTP_FROM=
